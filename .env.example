# ATLAS environment — copy to .env and fill in. NEVER commit the real .env.
# All of these are read server-side only (Vite dev middleware) and never reach the browser.

# Chat is served by a provider chain of OpenAI-compatible endpoints. The first
# configured key wins; on any error it falls through to the next. Order:
#   Groq (fast, primary) -> OpenRouter -> OpenRouter fallback key -> OpenAI.
# Leave a key empty to skip that provider. Base URLs/models have safe defaults.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY_FALLBACK=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ElevenLabs text-to-speech (optional — voice works only if set)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Tavily web search for Deep Research mode (optional)
TAVILY_API_KEY=
